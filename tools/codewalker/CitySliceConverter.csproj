<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <CodeWalkerSourceDir Condition="'$(CodeWalkerSourceDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\CodeWalker</CodeWalkerSourceDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CodeWalkerSourceDir)\CodeWalker.Core\CodeWalker.Core.csproj" />
  </ItemGroup>
</Project>
